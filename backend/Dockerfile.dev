FROM node:22-alpine
RUN apk add --no-cache ffmpeg font-dejavu

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy prisma schema
COPY prisma ./prisma
RUN npx prisma generate

# Expose the application port
EXPOSE 3001

# Start the application in development mode
CMD ["npm", "run", "dev:api"]
