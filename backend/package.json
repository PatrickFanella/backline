{
    "name": "backline-backend",
    "version": "1.0.0",
    "description": "Backline Discord community bot and API",
    "main": "src/index.ts",
    "scripts": {
        "dev": "nodemon --watch src --exec ts-node src/index.ts",
        "dev:api": "nodemon --watch src --exec ts-node --files src/server.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:unit": "jest __tests__/unit",
        "test:integration": "jest __tests__/integration",
        "test:e2e": "jest __tests__/e2e",
        "build": "tsc",
        "type-check": "tsc --noEmit",
        "sentry:sourcemaps": "./scripts/upload-sourcemaps.sh",
        "prisma:validate": "prisma validate",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:seed": "ts-node prisma/seed.ts",
        "db:migrate": "ts-node ../scripts/migrate-to-postgres.ts",
        "db:migrate:dry": "DRY_RUN=true ts-node ../scripts/migrate-to-postgres.ts",
        "db:backup": "../scripts/backup.sh",
        "db:restore": "../scripts/restore.sh",
        "db:maintenance": "../scripts/maintenance.sh",
        "db:fulltext": "../scripts/setup-fulltext-search.sh",
        "backup:health-check": "ts-node -e \"import('./src/utils/backupMonitor').then(m => m.checkBackupHealth().then(r => console.log(r)))\"",
        "backup:stats": "ts-node -e \"import('./src/utils/backupMonitor').then(m => m.getBackupStats().then(r => console.log(r)))\"",
        "backup:recent": "ts-node -e \"import('./src/utils/backupMonitor').then(m => m.getRecentBackups().then(r => console.log(r)))\"",
        "wal:setup": "../scripts/setup-wal-archiving.sh",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\""
    },
    "keywords": [],
    "author": "",
    "license": "GPL-3.0-or-later",
    "type": "commonjs",
    "dependencies": {
        "@discordjs/voice": "0.19.2",
        "@prisma/client": "6.19.3",
        "@sentry/node": "^10.22.0",
        "@sentry/tracing": "^7.120.4",
        "@socket.io/redis-adapter": "^8.3.0",
        "@types/lodash": "^4.17.20",
        "axios": "^1.9.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "discord.js": "^14.19.3",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "express-rate-limit": "^8.1.0",
        "express-slow-down": "^3.0.0",
        "fast-xml-parser": "5.11.2",
        "helmet": "^8.1.0",
        "ioredis": "^5.8.2",
        "ipaddr.js": "2.5.0",
        "jsonwebtoken": "^9.0.2",
        "lodash": "^4.17.21",
        "morgan": "^1.10.0",
        "opusscript": "0.0.8",
        "prisma": "6.19.3",
        "prom-client": "^15.1.3",
        "rate-limit-redis": "^4.2.3",
        "redoc-express": "^2.1.3",
        "sharp": "0.35.5",
        "socket.io": "^4.8.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^13.0.0",
        "winston": "^3.17.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@playwright/test": "^1.64.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.18",
        "@types/express": "^5.0.2",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/morgan": "^1.9.9",
        "@types/node": "^24.9.0",
        "@types/socket.io-client": "^1.4.36",
        "@types/supertest": "^7.2.1",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "eslint": "^9.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-security": "^3.0.1",
        "jest": "^30.2.0",
        "nodemon": "^3.1.10",
        "playwright": "^1.56.1",
        "prettier": "^3.9.10",
        "socket.io-client": "^4.8.4",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.72.0"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "overrides": {
        "@prisma/config": {
            "deepmerge-ts": "8.0.2"
        },
        "proxy-addr": "2.0.8"
    }
}
