# Runtime secrets and deployment settings for one Backline release.
# Copy outside Git with mode 600. Every value below is a non-working placeholder.

DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URI=https://backline.example.invalid/auth/callback

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=https://backline.example.invalid
FRONTEND_URL=https://backline.example.invalid
ADMIN_DISCORD_IDS=
BOT_GUILD_IDS=

# Set only the Gateway intents that the enabled modules require.
BOT_MEMBER_INTENTS=false
BOT_MESSAGE_INTENTS=false
BOT_MESSAGE_CONTENT_INTENT=false
BOT_ACTIVITY_INTENTS=false
BOT_VOICE_INTENT=false
# Set true for a release that changes slash commands, then return to false.
BOT_REGISTER_COMMANDS=false

# Optional provider credentials. Remove unused variables instead of leaving real values here.
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
